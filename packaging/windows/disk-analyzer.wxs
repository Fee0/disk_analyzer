<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?define ExplorerMenuLabel = "Scan with Disk Analyzer" ?>
  <?define InstalledExe = "[INSTALLFOLDER]disk-analyzer.exe" ?>
  <Package
    Name="Disk Analyzer"
    Manufacturer="Frederik Peukert"
    Version="$(Version)"
    UpgradeCode="F18E6A41-1856-45CE-900F-5787F33961E7"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Disk Analyzer is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="DiskAnalyzerIcon" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="DiskAnalyzerIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://disk-analyzer.com" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Fee0/disk_analyzer/issues" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Disk Analyzer">
        <Component Id="Executable">
          <File Id="DiskAnalyzerExe" Source="$(Exe)" KeyPath="yes" />
        </Component>
        <Component Id="License">
          <File Id="LicenseFile" Source="$(License)" Name="LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="ExplorerMenuOnFolders">
          <RegistryKey Root="HKLM" Key="Software\Classes\Directory\shell\DiskAnalyzer" ForceDeleteOnUninstall="yes">
            <RegistryValue Type="string" Value="$(ExplorerMenuLabel)" KeyPath="yes" />
            <RegistryValue Name="Icon" Type="string" Value="&quot;$(InstalledExe)&quot;,0" />
            <RegistryValue Key="command" Type="string" Value="&quot;$(InstalledExe)&quot; &quot;%V\.&quot;" />
          </RegistryKey>
        </Component>
        <Component Id="ExplorerMenuInsideFolders">
          <RegistryKey Root="HKLM" Key="Software\Classes\Directory\Background\shell\DiskAnalyzer" ForceDeleteOnUninstall="yes">
            <RegistryValue Type="string" Value="$(ExplorerMenuLabel)" KeyPath="yes" />
            <RegistryValue Name="Icon" Type="string" Value="&quot;$(InstalledExe)&quot;,0" />
            <RegistryValue Key="command" Type="string" Value="&quot;$(InstalledExe)&quot; &quot;%V\.&quot;" />
          </RegistryKey>
        </Component>
        <Component Id="ExplorerMenuOnDrives">
          <RegistryKey Root="HKLM" Key="Software\Classes\Drive\shell\DiskAnalyzer" ForceDeleteOnUninstall="yes">
            <RegistryValue Type="string" Value="$(ExplorerMenuLabel)" KeyPath="yes" />
            <RegistryValue Name="Icon" Type="string" Value="&quot;$(InstalledExe)&quot;,0" />
            <RegistryValue Key="command" Type="string" Value="&quot;$(InstalledExe)&quot; &quot;%V\.&quot;" />
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut
          Id="DiskAnalyzerShortcut"
          Name="Disk Analyzer"
          Description="See what takes up space on your disk"
          Target="[INSTALLFOLDER]disk-analyzer.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Disk Analyzer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature
      Id="Main"
      Title="Disk Analyzer"
      Description="The app and its Start menu shortcut."
      AllowAbsent="no"
      AllowAdvertise="no"
      Display="expand">
      <ComponentRef Id="Executable" />
      <ComponentRef Id="License" />
      <ComponentRef Id="StartMenuShortcut" />
      <Feature
        Id="ExplorerMenu"
        Title="Explorer menu entry"
        Description="Adds “$(ExplorerMenuLabel)” when you right-click a folder or a drive."
        AllowAdvertise="no">
        <ComponentRef Id="ExplorerMenuOnFolders" />
        <ComponentRef Id="ExplorerMenuInsideFolders" />
        <ComponentRef Id="ExplorerMenuOnDrives" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(Banner)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(Dialog)" />
  </Package>
</Wix>
